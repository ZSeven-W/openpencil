# 解析到腾讯云 CVM 的公网域名。
# Caddy 使用这个域名申请和续期 HTTPS 证书。
APP_DOMAIN=openpencil.example.com

# GitHub Actions 构建出来的 Docker 镜像。
# 每次部署时，流水线都会写入一个不可变的 sha-* 镜像标签。
OPENPENCIL_IMAGE=ghcr.io/owner/repo:sha-000000000000

# OpenPencil 容器内 Nitro 服务的运行参数。
NODE_ENV=production
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Supabase 项目地址和 anon key。
# VITE_* 会在镜像构建期编译进前端代码；非 VITE 变量由 Nitro 服务端接口在运行期读取。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 服务端高权限 Supabase key，仅 Nitro/Worker 服务端使用。
# 不能加 VITE_ 前缀，不能暴露给浏览器或桌面端。
SUPABASE_SERVICE_ROLE_KEY=

# 可选：full 镜像中的服务端 AI Provider 密钥。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
