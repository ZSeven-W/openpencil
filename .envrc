# -----------------------------------------------------------------------------
# OpenPencil 本地开发默认环境
# -----------------------------------------------------------------------------

# 本地 dev server 与 Electron 都依赖 loopback 回环地址互相访问。
# 如果系统启用了 http_proxy / https_proxy / all_proxy, 但没有 NO_PROXY,
# 本地 SSR 文档请求会被错误转发给代理并返回 502。
export NO_PROXY="${NO_PROXY:-127.0.0.1,localhost,::1}"
export no_proxy="${no_proxy:-127.0.0.1,localhost,::1}"
