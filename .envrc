# -----------------------------------------------------------------------------
# Default local development environment for OpenPencil
# -----------------------------------------------------------------------------

# The local dev server and Electron both depend on direct loopback access.
# If http_proxy / https_proxy / all_proxy are enabled without NO_PROXY,
# local SSR document requests can be sent to the proxy by mistake and return 502.
export NO_PROXY="${NO_PROXY:-127.0.0.1,localhost,::1}"
export no_proxy="${no_proxy:-127.0.0.1,localhost,::1}"
