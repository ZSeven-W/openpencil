{"version":"1.1","children":[{"type":"frame","id":"n1","name":"复利效应知识卡","x":0.0,"y":0.0,"width":1080.0,"height":1350.0,"layout":"vertical","gap":24.0,"padding":[64.0,64.0,56.0,64.0],"clipContent":true,"fill":[{"type":"linear_gradient","angle":155.0,"stops":[{"offset":0.0,"color":"#FFF9F2"},{"offset":0.55,"color":"#FDEDDA"},{"offset":1.0,"color":"#F8DCBE"}]}],"children":[{"type":"frame","id":"n2","name":"header","width":"fill_container","height":"fit_content","layout":"vertical","gap":18.0,"fill":[],"children":[{"type":"frame","id":"n3","name":"eyebrow-row","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16.0,"justifyContent":"space_between","alignItems":"center","fill":[],"children":[{"type":"frame","id":"n4","name":"eyebrow-pill","width":"fit_content","height":"fit_content","layout":"horizontal","padding":[10.0,22.0],"alignItems":"center","cornerRadius":999.0,"fill":[{"type":"solid","color":"#F7DCBB"}],"children":[{"type":"text","id":"n5","name":"eyebrow-label","width":"fit_content","height":"fit_content","content":"思维模型 · 01","fontFamily":"Noto Sans SC","fontSize":24.0,"fontWeight":700,"letterSpacing":0.0,"lineHeight":1.45,"textAlign":"left","fill":[{"type":"solid","color":"#A03E12"}]}]},{"type":"text","id":"n6","name":"eyebrow-stat","width":"fit_content","height":"fit_content","content":"每天 1% · 一年 37 倍","fontFamily":"Noto Sans SC","fontSize":26.0,"fontWeight":700,"letterSpacing":0.0,"lineHeight":1.45,"textAlign":"right","fill":[{"type":"solid","color":"#C1560F"}]}]},{"type":"text","id":"n7","name":"card-title","width":"fill_container","height":"fit_content","content":"复利效应","fontFamily":"Noto Sans SC","fontSize":96.0,"fontWeight":800,"letterSpacing":-1.5,"lineHeight":1.06,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#3A2415"}]},{"type":"rectangle","id":"n8","name":"title-rule","width":120.0,"height":8.0,"cornerRadius":4.0,"fill":[{"type":"solid","color":"#C1560F"}],"children":[]}]},{"type":"text","id":"n9","name":"core-explanation","width":"fill_container","height":"fit_content","content":"复利效应是指收益本身继续产生收益：每一次微小的增长都被叠进下一轮的起点。它在短期内几乎看不见，却会在足够长的时间里，把微弱的差距放大成难以追赶的鸿沟。","fontFamily":"Inter","fontSize":30.0,"fontWeight":400,"letterSpacing":0.0,"lineHeight":1.75,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#5A3F2B"}]},{"type":"frame","id":"n10","name":"points-list","width":"fill_container","height":"fit_content","layout":"vertical","gap":16.0,"fill":[],"children":[{"type":"frame","id":"n11","name":"point-card-01","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24.0,"padding":[28.0,32.0],"alignItems":"start","cornerRadius":24.0,"fill":[{"type":"solid","color":"#FFFFFF"}],"stroke":{"thickness":2.0,"fill":[{"type":"solid","color":"#F2DFC7"}]},"children":[{"type":"frame","id":"n12","name":"point-badge-01","width":72.0,"height":72.0,"layout":"horizontal","justifyContent":"center","alignItems":"center","cornerRadius":36.0,"fill":[{"type":"solid","color":"#C1560F"}],"children":[{"type":"text","id":"n13","name":"point-num-01","width":"fit_content","height":"fit_content","content":"01","fontFamily":"Inter","fontSize":30.0,"fontWeight":800,"letterSpacing":0.0,"lineHeight":1.2,"textAlign":"center","fill":[{"type":"solid","color":"#FFFFFF"}]}]},{"type":"frame","id":"n14","name":"point-body-01","width":"fill_container","height":"fit_content","layout":"vertical","gap":10.0,"fill":[],"children":[{"type":"text","id":"n15","name":"point-title-01","width":"fill_container","height":"fit_content","content":"起点微小，斜率才是关键","fontFamily":"Noto Sans SC","fontSize":38.0,"fontWeight":700,"letterSpacing":0.0,"lineHeight":1.35,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#3A2415"}]},{"type":"text","id":"n16","name":"point-desc-01","width":"fill_container","height":"fit_content","content":"早期的差距小到几乎看不见，真正拉开距离的，是每一轮能否稳住那一点点增长率。","fontFamily":"Inter","fontSize":26.0,"fontWeight":400,"letterSpacing":0.0,"lineHeight":1.75,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#8A6A52"}]}]}]},{"type":"frame","id":"n17","name":"point-card-02","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24.0,"padding":[28.0,32.0],"alignItems":"start","cornerRadius":24.0,"fill":[{"type":"solid","color":"#FFFFFF"}],"stroke":{"thickness":2.0,"fill":[{"type":"solid","color":"#F2DFC7"}]},"children":[{"type":"frame","id":"n18","name":"point-badge-02","width":72.0,"height":72.0,"layout":"horizontal","justifyContent":"center","alignItems":"center","cornerRadius":36.0,"fill":[{"type":"solid","color":"#C1560F"}],"children":[{"type":"text","id":"n19","name":"point-num-02","width":"fit_content","height":"fit_content","content":"02","fontFamily":"Inter","fontSize":30.0,"fontWeight":800,"letterSpacing":0.0,"lineHeight":1.2,"textAlign":"center","fill":[{"type":"solid","color":"#FFFFFF"}]}]},{"type":"frame","id":"n20","name":"point-body-02","width":"fill_container","height":"fit_content","layout":"vertical","gap":10.0,"fill":[],"children":[{"type":"text","id":"n21","name":"point-title-02","width":"fill_container","height":"fit_content","content":"时间是唯一的放大器","fontFamily":"Noto Sans SC","fontSize":38.0,"fontWeight":700,"letterSpacing":0.0,"lineHeight":1.35,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#3A2415"}]},{"type":"text","id":"n22","name":"point-desc-02","width":"fill_container","height":"fit_content","content":"同样的年化收益率，多坚持十年，结果不是多出一截，而是整整翻上好几倍。","fontFamily":"Inter","fontSize":26.0,"fontWeight":400,"letterSpacing":0.0,"lineHeight":1.75,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#8A6A52"}]}]}]},{"type":"frame","id":"n23","name":"point-card-03","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24.0,"padding":[28.0,32.0],"alignItems":"start","cornerRadius":24.0,"fill":[{"type":"solid","color":"#FFFFFF"}],"stroke":{"thickness":2.0,"fill":[{"type":"solid","color":"#F2DFC7"}]},"children":[{"type":"frame","id":"n24","name":"point-badge-03","width":72.0,"height":72.0,"layout":"horizontal","justifyContent":"center","alignItems":"center","cornerRadius":36.0,"fill":[{"type":"solid","color":"#C1560F"}],"children":[{"type":"text","id":"n25","name":"point-num-03","width":"fit_content","height":"fit_content","content":"03","fontFamily":"Inter","fontSize":30.0,"fontWeight":800,"letterSpacing":0.0,"lineHeight":1.2,"textAlign":"center","fill":[{"type":"solid","color":"#FFFFFF"}]}]},{"type":"frame","id":"n26","name":"point-body-03","width":"fill_container","height":"fit_content","layout":"vertical","gap":10.0,"fill":[],"children":[{"type":"text","id":"n27","name":"point-title-03","width":"fill_container","height":"fit_content","content":"中断一次，代价极高","fontFamily":"Noto Sans SC","fontSize":38.0,"fontWeight":700,"letterSpacing":0.0,"lineHeight":1.35,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#3A2415"}]},{"type":"text","id":"n28","name":"point-desc-03","width":"fill_container","height":"fit_content","content":"一次大亏或长期停摆会削掉复利的底数，补回来所需的时间，远比损失本身更贵。","fontFamily":"Inter","fontSize":26.0,"fontWeight":400,"letterSpacing":0.0,"lineHeight":1.75,"textAlign":"left","textGrowth":"fixed-width","fill":[{"type":"solid","color":"#8A6A52"}]}]}]}]},{"type":"frame","id":"n29","name":"footer","width":"fill_container","height":"fit_content","layout":"vertical","gap":20.0,"fill":[],"children":[{"type":"rectangle","id":"n30","name":"footer-divider","width":"fill_container","height":2.0,"cornerRadius":1.0,"fill":[{"type":"solid","color":"#EBD5B9"}],"children":[]},{"type":"frame","id":"n31","name":"footer-row","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24.0,"justifyContent":"space_between","alignItems":"center","fill":[],"children":[{"type":"frame","id":"n32","name":"signature","width":"fill_container","height":"fit_content","layout":"vertical","gap":10.0,"fill":[],"children":[{"type":"tex