；\n杯子可以带回来，下一杯减三块。","fontFamily":"Noto Sans SC","fontSize":17,"fontWeight":400,"fill":[{"type":"solid","color":"$band-muted"}],"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","width":"fill_container"}]},{"type":"rectangle","id":"r130","name":"故事分隔线","width":"fill_container","height":1,"fill":[{"type":"solid","color":"$band-rule"}]},{"type":"frame","id":"f129","name":"故事数据行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":0,"alignItems":"start","fill":[],"children":[{"type":"frame","id":"f122","name":"故事数据 第一家店开业","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"fill":[],"children":[{"type":"text","id":"t120","name":"标签 2014","content":"2014","fontFamily":"Inter","fontSize":32,"fontWeight":700,"fill":[{"type":"solid","color":"$primary-foreground"}],"lineHeight":1.1,"letterSpacing":0,"textGrowth":"auto","width":"fit_content"},{"type":"text","id":"t121","name":"标签 第一家店开业","content":"第一家店开业","fontFamily":"Noto Sans SC","fontSize":14,"fontWeight":400,"fill":[{"type":"solid","color":"$band-muted"}],"lineHeight":1.3,"letterSpacing":0,"textGrowth":"auto","width":"fit_content"}]},{"type":"frame","id":"f125","name":"故事数据 个合作庄园","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"fill":[],"children":[{"type":"text","id":"t123","name":"标签 4","content":"4","fontFamily":"Inter","fontSize":32,"fontWeight":700,"fill":[{"type":"solid","color":"$primary-foreground"}],"lineHeight":1.1,"letterSpacing":0,"textGrowth":"auto","width":"fit_content"},{"type":"text","id":"t124","name":"标签 个合作庄园","content":"个合作庄园","fontFamily":"Noto Sans SC","fontSize":14,"fontWeight":400,"fill":[{"type":"solid","color":"$band-muted"}],"lineHeight":1.3,"letterSpacing":0,"textGrowth":"auto","width":"fit_content"}]},{"type":"frame","id":"f128","name":"故事数据 位咖啡师","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"fill":[],"children":[{"type":"text","id":"t126","name":"标签 32","content":"32","fo