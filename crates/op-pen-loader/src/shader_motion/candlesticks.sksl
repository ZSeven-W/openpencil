uniform float2 size;
uniform float time;
uniform float sampleTime;
uniform float focal;
uniform float baseline;
uniform float edgeSoftness;
// Floor gap in scene pixels, grid strength, bevel light, projected trails.
uniform float4 stage;
uniform float4 view;
uniform float4 lens;

float hash(float2 q){return fract(sin(dot(q,float2(127.1,311.7)))*43758.5453);}
float3 neon(float4 bar){return bar.w>=bar.x?float3(2.8,.025,.29):float3(.01,2.6,1.08);}

float harmonic(float a,float b){return a*b>0.?2./(1./a+1./b):0.;}

// The camera follows a C1 price curve, including across candle boundaries.
float price_at(float progress){
    int i=int(floor(progress));
    float u=progress-float(i),u2=u*u,u3=u2*u;
    float a=candleAt(i>0?i-1:0).w,b=candleAt(i).w;
    float c=candleAt(i+1<CANDLE_COUNT?i+1:CANDLE_COUNT-1).w;
    float d=candleAt(i+2<CANDLE_COUNT?i+2:CANDLE_COUNT-1).w;
    return (2.*u3-3.*u2+1.)*b+(u3-2.*u2+u)*harmonic(b-a,c-b)
        +(-2.*u3+3.*u2)*c+(u3-u2)*harmonic(c-b,d-c);
}

float box_hit(float3 ro,float3 rd,float3 c,float3 h,float pixelCone,out float3 normal,out float coverage){
    float3 inv=1.0/(sign(rd+float3(.00000001))*max(abs(rd),float3(.000001)));
    float3 lo=(c-h-ro)*inv,hi=(c+h-ro)*inv;
    float3 a=min(lo,hi),b=max(lo,hi);
    float near=max(a.x,max(a.y,a.z));
    float far=min(b.x,min(b.y,b.z));
    float footprint=max(near,.001)*pixelCone;
    coverage=clamp(.5+(far-near)*.5/max(footprint,.00001),0.,1.);
    if(far<0.||coverage<=0.)return -1.;
    normal=a.x>=a.y&&a.x>=a.z?float3(-sign(rd.x),0,0):
           a.y>=a.z?float3(0,-sign(rd.y),0):float3(0,0,-sign(rd.z));
    return near;
}

float distance_segment(float2 p,float2 a,float2 b){
    float2 v=b-a;
    return length(p-a-v*clamp(dot(p-a,v)/max(dot(v,v),.0001),0.,1.));
}

float2 project(float3 w,float3 eye,float3 right,float3 up,float3 forward,float safeFocal){
    float3 v=w-eye;
    float z=max(.01,dot(v,forward));
    return float2(360.+safeFocal*dot(v,right)/z,820.-safeFocal*dot(v,up)/z);
}

float grid_distance(float position, float stepSize){
    return abs(fract(position/stepSize+.5)-.5)*stepSize;
}

half4 main(float2 coord){
    float2 p=coord*float2(720.,1280.)/max(size,float2(1.));
    float t=sampleTime>=0.?sampleTime:time;
    float4 currentView=view;
    float endpoint=lens.x;
    float4 currentCamera=float4(lens.y,lens.z,focal,lens.w);
    VIEW_SAMPLE
    CAMERA_SAMPLE
    float progress=clamp(currentView.x,0.,float(CANDLE_COUNT-1));
    float spacing=max(currentView.y,.1),scale=max(currentView.z,.001),cursor=currentView.w;
    float yaw=clamp(currentCamera.x,-1.2,1.2),pitch=clamp(currentCamera.y,-1.2,1.2);
    float safeFocal=max(currentCamera.z,100.);
    float glowStrength=clamp(currentCamera.w,0.,4.);
    float stepSize=.30;
    float sy=stepSize*scale/max(spacing,.1);
    int completed=int(floor(progress));
    int last=completed+1<CANDLE_COUNT?completed+1:CANDLE_COUNT-1;
    float growth=last==completed?1.:progress-float(completed);
    float4 previous=candleAt(completed),lastbar=candleAt(last);
    float headPrice=price_at(progress);
    float3 head=float3(progress*stepSize,(headPrice-baseline)*sy,0.);
    float distance=safeFocal*stepSize/max(spacing,.1);
    float3 forward=normalize(float3(sin(yaw)*cos(pitch),-sin(pitch),cos(yaw)*cos(pitch)));
    float3 right=normalize(cross(float3(0.,1.,0.),forward));
    float3 up=cross(forward,right);
    float3 eye=head-forward*distance-right*((cursor-360.)*stepSize/spacing)-up*((820.-endpoint)*stepSize/spacing);
    float3 ray=normalize(forward+right*((p.x-360.)/safeFocal)+up*((820.-p.y)/safeFocal));

    // Place the floor so its center line crosses a point below the cursor.
    // Intersect both the reference ray and the actual pixel ray with the
    // corresponding world planes, so the floor rotates with the camera.
    float floorY=0.;
    float grid=clamp(stage.y,0.,2.);
    float polish=clamp(stage.z,0.,2.);
    float projectedTrails=clamp(stage.w,0.,1.);
    if(grid>0.||projectedTrails>0.){
        float floorPixel=max(endpoint+clamp(stage.x,20.,400.),1000.);
        float3 floorRay=forward+right*((cursor-360.)/safeFocal)+up*((820.-floorPixel)/safeFocal);
        floorY=eye.y-eye.z*floorRay.y/max(.05,floorRay.z);
    }

    float2 uv=p/float2(720.,1280.);
    float fog=exp(-dot((uv-float2(.68,.80))*float2(3.,3.8),(uv-float2(.68,.80))*float2(3.,3.8)));
    float3 radiance=float3(.0025,.004,.007)+float3(.013,.033,.082)*fog;
    float2 dust=p*.35+float2(0.,t*.65);
    float star=step(.9982,hash(floor(dust)))*(1.-smoothstep(.04,.25,length(fract(dust)-.5)));
    radiance+=star*.09;
    if(grid>0.&&ray.y<-.002){
        float floorT=(floorY-eye.y)/ray.y;
        if(floorT>0.){
            float3 floorHit=eye+ray*floorT;
            float lineWidth=max(.0005,floorT/safeFocal);
            float gridDist=min(grid_distance(floorHit.x,.9),grid_distance(floorHit.z,.9));
            float line=1.-smoothstep(0.,lineWidth*1.1,gridDist);
            float axis=1.-smoothstep(0.,lineWidth*1.3,abs(floorHit.z));
            float fade=exp(-abs(floorHit.z)*.13-abs(floorHit.x-head.x)*.035);
            radiance+=grid*fade*(line*float3(.012,.019,.032)+axis*float3(.04,.067,.095));
        }
    }
    float planeT=-eye.z/ray.z;
    float planeX=eye.x+planeT*ray.x;
    int candidate=int(floor(planeX/stepSize+.5));
    float closest=1.e10;
    float surfaceCoverage=0.;
    float3 surface=float3(0.);
    float3 glow=float3(0.);
    for(int k=-2;k<=2;k++){
        int i=candidate+k;
        if(i<0||i>last||i>=CANDLE_COUNT)continue;
        float4 b=candleAt(i);
        float3 color=neon(b);
        float barIndex=float(i),visibility=1.;
        if(i==last&&last!=completed){
            float reveal=smoothstep(0.,1.,growth);
            float upper=b.y-max(b.x,b.w),lower=min(b.x,b.w)-b.z;
            b.x=mix(previous.w,b.x,reveal);
            b.w=headPrice;
            b.y=max(b.x,b.w)+upper*reveal;
            b.z=min(b.x,b.w)-lower*reveal;
            barIndex=progress;
            visibility=smoothstep(0.,.18,growth);
        }
        float open=(b.x-baseline)*sy,close=(b.w-baseline)*sy;
        float high=(b.y-baseline)*sy,low=(b.z-baseline)*sy;
        float3 center=float3(barIndex*stepSize,(open+close)*.5,0.);
        float3 halfsize=float3(.104*max(.05,visibility),max(abs(close-open)*.5,.020),.19);
        float3 n;
        float coverage;
        float hit=box_hit(eye,ray,center,halfsize,clamp(edgeSoftness,.25,2.)/safeFocal,n,coverage);
        if(hit>0.&&hit<closest&&visibility>.001){
            closest=hit;
            surfaceCoverage=coverage*visibility;
            float3 q=clamp(eye+ray*hit-center,-halfsize,halfsize);
            float lighting=.38+.62*max(dot(n,normalize(float3(-.4,.8,-.6))),0.);
            float rim=pow(1.-max(dot(-ray,n),0.),3.);
            float top=n.y>.5?1.:0.;
            surface=color*(.20+.48*lighting)+float3(.40,.70,.62)*top*.26+color*rim*.18;
            // On a face, one axis distance is zero everywhere. The second
            // smallest distance selects actual edges, not the entire face.
            float3 e=abs(halfsize-abs(q));
            float edge=max(min(e.x,e.y),min(max(e.x,e.y),e.z));
            float seam=1.-smoothstep(.002,.010,edge);
            surface+=float3(.45,.75,.65)*seam*.20;
            // A broad body highlight and a narrow bevel keep the light
            // attached to the solid as the viewing angle changes.
            float heightTone=clamp(.5+.5*q.y/halfsize.y,0.,1.);
            float3 highlight=mix(color,float3(1.8,1.8,1.7),.45);
            float topLight=heightTone*heightTone;
            surface+=polish*(highlight*topLight*.29+highlight*seam*.24);
            surface*=1.-polish*.12*(1.-heightTone);
        }
        float2 a=project(float3(barIndex*stepSize,open,-.19),eye,right,up,forward,safeFocal);
        float2 z=project(float3(barIndex*stepSize,close,-.19),eye,right,up,forward,safeFocal);
        float d=distance_segment(p,a,z);
        float weight=visibility*(1.-smoothstep(1.5,2.5,abs(planeX/stepSize-barIndex)));
        glow+=color*(.13*exp(-d/2.3)+.026*exp(-d/9.))*glowStrength*weight;
        float2 wh=project(float3(barIndex*stepSize,high,0.),eye,right,up,forward,safeFocal);
        float2 wl=project(float3(barIndex*stepSize,low,0.),eye,right,up,forward,safeFocal);
        float2 bodyTop=project(float3(barIndex*stepSize,max(open,close),0.),eye,right,up,forward,safeFocal);
        float2 bodyBottom=project(float3(barIndex*stepSize,min(open,close),0.),eye,right,up,forward,safeFocal);
        float wd=min(high>max(open,close)+.001?distance_segment(p,wh,bodyTop):1.e5,
                     low<min(open,close)-.001?distance_segment(p,wl,bodyBottom):1.e5);
        glow+=color*(1.-smoothstep(.25,.95,wd))*.38*weight;
        float2 origin=project(float3(barIndex*stepSize,min(low,close)-.05,0.),eye,right,up,forward,safeFocal);
        float trail=exp(-abs(p.x-origin.x)/.7)*exp(-max(0.,p.y-origin.y)/240.);
        if(p.y>origin.y)glow+=color*trail*.045*weight*(1.-projectedTrails);
        if(projectedTrails>0.&&floorY<low){
            float2 floorPoint=project(float3(barIndex*stepSize,floorY,0.),eye,right,up,forward,safeFocal);
            float2 descent=floorPoint-origin;
            float trailProgress=dot(p-origin,descent)/max(dot(descent,descent),.001);
            if(trailProgress>0.&&trailProgress<1.){
                float trailDistance=length(p-origin-descent*trailProgress);
                float light=exp(-trailDistance/1.6)*pow(1.-trailProgress,1.55);
                glow+=color*light*.12*projectedTrails*weight;
            }
        }
    }
    radiance+=glow;
    if(closest<1.e9)radiance=mix(radiance,surface,surfaceCoverage);
    float3 headcolor=mix(neon(previous),neon(lastbar),smoothstep(0.,1.,growth));
    float2 delta=p-float2(cursor,endpoint);
    float halo=exp(-length(delta)/15.)*.32;
    float flare=exp(-abs(delta.y)/.6-abs(delta.x)/39.)*.72+exp(-abs(delta.x)/.6-abs(delta.y)/21.)*.54;
    radiance+=headcolor*halo+float3(.72,1.,.88)*flare;
    float f1=abs(p.y-(1080.+.18*(p.x-360.)));
    radiance+=float3(.035,.055,.065)*exp(-f1*.8)*.20*(1.-min(grid,1.));
    float3 mapped=1.-exp(-radiance*1.13);
    return half4(mapped,1.);
}
