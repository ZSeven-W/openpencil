            },
            "width": {
              "type": "number",
            },
          },
          "required": [
            "width",
            "height",
          ],
          "type": "object",
        },
        "sections": {
          "description": "Section frame definitions. Each section becomes a direct child of root. Props: name (required), height, layout, padding, gap, fill, role, justifyContent, alignItems.",
          "items": {
            "properties": {
              "alignItems": {
                "type": "string",
              },
              "fill": {
                "items": {
                  "type": "object",
