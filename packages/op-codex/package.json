{
  "name": "@zseven-w/codex-openpencil",
  "version": "0.3.13",
  "description": "OpenPencil design workflows, interactive Rust canvas, and local MCP bridge for Codex.",
  "license": "MIT",
  "keywords": [
    "codex",
    "openpencil",
    "plugin",
    "design",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZSeven-W/openpencil.git",
    "directory": "packages/op-codex"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-openpencil": "./bin/codex-openpencil.mjs"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    "bin",
    "plugins",
    "scripts",
    "platforms.json",
    "INSTALL.md",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-package.mjs",
    "doctor": "node plugins/openpencil/scripts/mcp-bridge.mjs --doctor",
    "host-check": "node scripts/plugin-host-check.mjs",
    "configure-runtime": "node scripts/configure-runtime.mjs",
    "canvas-smoke": "node scripts/canvas-smoke.mjs",
    "selection-smoke": "node scripts/selection-smoke.mjs",
    "images-smoke": "node scripts/images-smoke.mjs",
    "mobile-smoke": "node scripts/mobile-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "setup": "node scripts/setup.mjs",
    "canvas": "node scripts/canvas.mjs",
    "codegen-smoke": "node scripts/codegen-smoke.mjs",
    "build:editor-runtime": "node scripts/build-editor-runtime.mjs",
    "stage:editor-runtime": "node scripts/stage-editor-runtime.mjs",
    "stage:runtime": "npm run stage:editor-runtime",
    "verify:packages": "node scripts/verify-platform-packages.mjs",
    "release:sync": "node scripts/sync-platform-versions.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "pack:artifact": "node scripts/pack-package.mjs",
    "verify:install": "node scripts/verify-selective-install.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "test:release-publish": "node --test tests/registry-convergence.test.mjs && node scripts/publish-release.mjs --self-test"
  },
  "optionalDependencies": {
    "@zseven-w/codex-openpencil-darwin-arm64": "0.3.13",
    "@zseven-w/codex-openpencil-darwin-x64": "0.3.13",
    "@zseven-w/codex-openpencil-linux-arm64": "0.3.13",
    "@zseven-w/codex-openpencil-linux-x64": "0.3.13",
    "@zseven-w/codex-openpencil-win32-arm64": "0.3.13",
    "@zseven-w/codex-openpencil-win32-x64": "0.3.13"
  }
}
