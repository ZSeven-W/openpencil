{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // One app for phone, tablet, and 2in1 (PC). The engine paints the whole
    // UI and picks its own responsive layout from the viewport it is given,
    // so no per-device HAP variant is needed.
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Native sign-in SDKs probe for the Alipay and Douyin apps before
    // launching their in-app authorization flows.
    "querySchemes": [
      "apmqpdispatch",
      "snssdk1128",
      "douyinopensdk",
      "weixin",
      "wxopensdk"
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // Mirrors the Android manifest, which declares no screenOrientation
        // and handles orientation/screenSize/density itself: the window
        // follows the user's rotation setting and the engine re-lays out.
        "orientation": "unspecified",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          // Return path for the Alipay landing page (jumps back through
          // render.alipay.com when Alipay was installed mid-flow).
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "render.alipay.com",
                "pathStartWith": "p/s/i"
              }
            ]
          },
          // Douyin OpenSDK returns on this App Link; op.zseven.cn must host
          // applinking.json listing this bundle, and the Douyin console must
          // whitelist the same link for the HarmonyOS app.
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "op.zseven.cn",
                "pathStartWith": "harmony/douyin-auth"
              }
            ],
            "domainVerify": true
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_internet_reason",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  }
}
