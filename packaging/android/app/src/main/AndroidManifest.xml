<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Native sign-in SDKs probe for the Douyin and Alipay apps. -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="hk.alipay.wallet" />
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BackgroundGenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Alipay SDK return-jump activity: the SDK ships it without an
             intent-filter; re-declaring it binds the app-unique scheme the
             in-app authorization passes to OpenAuthTask.execute. -->
        <activity
            android:name="com.alipay.sdk.app.AlipayResultActivity"
            android:exported="true"
            android:launchMode="singleTask"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openpencilalipay" />
            </intent-filter>
        </activity>

        <!-- WeChat OpenSDK auth callback. The SDK resolves this activity by
             the fixed `<applicationId>.wxapi.WXEntryActivity` naming
             convention; no intent-filter (Android 13+ breaks callbacks with
             one). It relays the auth response and finishes. -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="tech.zseven.openpencil"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Douyin OpenSDK auth callback. The SDK resolves this activity by
             the fixed `<applicationId>.douyinapi.DouYinEntryActivity` naming
             convention; it relays the auth response and finishes. -->
        <activity
            android:name=".douyinapi.DouYinEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="tech.zseven.openpencil" />
    </application>
</manifest>
