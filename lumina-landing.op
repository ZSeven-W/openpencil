                      "children": [
                        {
                          "type": "text",
                          "id": "n220",
                          "name": "faq-q-4",
                          "role": "subheading",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "Can I use my own sketches or photos as a reference?",
                          "fontFamily": "Space Grotesk",
                          "fontSize": 19.0,
                          "fontWeight": 600,
                          "letterSpacing": -0.3,
                          "lineHeight": 1.3,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F5F3FF"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n221",
                          "name": "faq-a-4",
                          "role": "body-text",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "Yes. Drop in a sketch, a photo, or a moodboard on Creator and above, and set how closely the render should follow it with a single strength slider.",
                          "fontFamily": "Inter",
                          "fontSize": 15.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#9C96B8"
                            }
                          ]
                        }
                      ]
                    },
