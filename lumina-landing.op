                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n224",
                          "name": "faq-a-5",
                          "role": "body-text",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "Around eight seconds for a preview set and roughly twenty for a 4K upscale. Studio plans render on a priority queue that stays fast during peak hours.",
                          "fontFamily": "Inter",
                          "fontSize": 15.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
