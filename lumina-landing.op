                      "type": "frame",
                      "id": "n219",
                      "name": "faq-item-4",
                      "width": "fill_container",
                      "height": "fit_content",
                      "layout": "vertical",
                      "gap": 10.0,
                      "padding": [
                        24.0,
                        0.0
                      ],
                      "fill": [],
                      "stroke": {
                        "thickness": {
                          "bottom": 1.0
                        },
                        "fill": [
