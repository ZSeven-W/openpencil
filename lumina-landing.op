                        ]
                      },
                      "children": [
                        {
                          "type": "text",
                          "id": "n211",
                          "name": "faq-q-1",
                          "role": "subheading",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "What exactly does one credit buy?",
                          "fontFamily": "Space Grotesk",
                          "fontSize": 19.0,
                          "fontWeight": 600,
                          "letterSpacing": -0.3,
                          "lineHeight": 1.3,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F5F3FF"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n212",
                          "name": "faq-a-1",
                          "role": "body-text",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "One credit covers a single 4K upscale and download. Prompting, the four preview variants, and any re-rolls cost nothing, so you only pay for images you actually keep.",
                          "fontFamily": "Inter",
                          "fontSize": 15.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#9C96B8"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "n213",
                      "name": "faq-item-2",
                      "width": "fill_container",
                      "height": "fit_content",
                      "layout": "vertical",
                      "gap": 10.0,
                      "padding": [
                        24.0,
                        0.0
                      ],
                      "fill": [],
                      "stroke": {
                        "thickness": {
                          "bottom": 1.0
                        },
                        "fill": [
                          {
                            "type": "solid",
                            "color": "#262042"
                          }
                        ]
                      },
                      "children": [
                        {
                          "type": "text",
                          "id": "n214",
                          "name": "faq-q-2",
                          "role": "subheading",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "Do unused credits expire?",
                          "fontFamily": "Space Grotesk",
                          "fontSize": 19.0,
                          "fontWeight": 600,
                          "letterSpacing": -0.3,
                          "lineHeight": 1.3,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F5F3FF"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n215",
                          "name": "faq-a-2",
                          "role": "body-text",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "No. Credits roll over month to month for as long as your plan stays active, and any credits you bought as a top-up pack stay on the account permanently.",
                          "fontFamily": "Inter",
                          "fontSize": 15.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#9C96B8"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "n216",
                      "name": "faq-item-3",
                      "width": "fill_container",
                      "height": "fit_content",
                      "layout": "vertical",
                      "gap": 10.0,
                      "padding": [
                        24.0,
                        0.0
                      ],
                      "fill": [],
                      "stroke": {
                        "thickness": {
                          "bottom": 1.0
                        },
                        "fill": [
                          {
                            "type": "solid",
                            "color": "#262042"
                          }
                        ]
                      },
                      "children": [
                        {
                          "type": "text",
                          "id": "n217",
                          "name": "faq-q-3",
                          "role": "subheading",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "Who owns the images I generate?",
                          "fontFamily": "Space Grotesk",
                          "fontSize": 19.0,
                          "fontWeight": 600,
                          "letterSpacing": -0.3,
                          "lineHeight": 1.3,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F5F3FF"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n218",
                          "name": "faq-a-3",
                          "role": "body-text",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "You do. Paid plans include full commercial rights with no attribution requirement, and we never train future models on your prompts or outputs.",
                          "fontFamily": "Inter",
                          "fontSize": 15.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#9C96B8"
                            }
                          ]
                        }
                      ]
                    },
